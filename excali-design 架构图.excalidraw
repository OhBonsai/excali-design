    {
      "type": "text", "id": "t15", "x": 820, "y": 600, "width": 340, "height": 175,
      "text": "BGM × 6 (tutorial/tech/education/ad)\n\nSFX × 7 categories:\n  ui/        (click, toggle, focus)\n  transition/ (whoosh, swipe, slide)\n  terminal/   (cursor, command)\n  progress/   (loading, complete)\n  magic/      (transform, sparkle)\n  keyboard/   (type, enter, delete)\n  impact/     (logo reveal, stamp)\n  feedback/   (success, error, notify)",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#495057", "opacity": 100, "angle": 0, "seed": 702, "version": 1,
      "versionNonce": 1, "isDeleted": false, "boundElements": null,
