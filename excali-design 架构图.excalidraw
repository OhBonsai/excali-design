    {
      "type": "text", "id": "t12", "x": 440, "y": 560, "width": 280, "height": 30,
      "text": "drawlib/\n组件库 · 7 库 ~185 组件", "fontSize": 16, "fontFamily": 2,
      "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#1e1e1e",
      "opacity": 100, "angle": 0, "seed": 601, "version": 1, "versionNonce": 1,
