      "text": "assets/\n音频资产 · BGM + SFX", "fontSize": 16, "fontFamily": 2,
      "textAlign": "center", "verticalAlign": "middle", "strokeColor": "#1e1e1e",
      "opacity": 100, "angle": 0, "seed": 701, "version": 1, "versionNonce": 1,
