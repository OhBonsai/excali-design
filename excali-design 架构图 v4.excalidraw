    {"type": "text", "id": "principles-list", "x": 580, "y": 356, "width": 600, "height": 176,
     "text": "#0  事实验证先于假设 → 读代码/搜文档\n#1  从 existing context 出发 → 不凭空画\n#2  drawlib 组件库复用 → 能复用绝不手绘\n#3  Junior Designer → 先 show 骨架再迭代\n#4  给 variations → 不给「最终答案」\n#5  Placeholder > 烂实现 → 诚实留白\n#6  System 优先 → 每个元素 earn its place\n#7  反手绘 slop → ≤4 色 · roughness≤1 · 网格对齐", "fontSize": 13, "fontFamily": 2,
     "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e",
     "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
     "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 42,
     "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null,
     "updated": 1748800000000, "link": null, "locked": false, "groupIds": [], "roundness": null},


