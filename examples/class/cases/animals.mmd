classDiagram
  class Animal {
    +String name
    +int age
    +makeSound() void
    +move() void
  }
  class Dog {
    +String breed
    +bark() void
  }
  class Cat {
    +bool indoor
    +meow() void
  }
  class Owner {
    +String name
  }
  Animal <|-- Dog
  Animal <|-- Cat
  Owner "1" *-- "many" Animal : owns
