    { "from": "lib", "to": "mer",  "kind": "dependency" },
    { "from": "mer", "to": "exc",  "kind": "flow" },
    { "from": "arch","to": "exc",  "kind": "flow" },
    { "from": "prot","to": "exc",  "kind": "flow" },
    { "from": "form","to": "exc",  "kind": "flow" },
    { "from": "exc", "to": "exp",  "kind": "flow" },
    { "from": "exp", "to": "art",  "kind": "flow" },
    { "from": "exc", "to": "floor","kind": "dependency" },
    { "from": "exc", "to": "lint", "kind": "dependency" },
    { "from": "fix", "to": "exc",  "kind": "flow" },
    { "from": "rc",  "to": "mer",  "kind": "dependency" }
  ],
  "hero": "mer",
