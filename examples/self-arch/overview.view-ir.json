    { "id": "mer",   "label": "渲染器(按图类型分发)" },
    { "id": "arch",  "label": "架构/拓扑" },
    { "id": "prot",  "label": "原型/海报" },
    { "id": "form",  "label": "公式" },
    { "id": "lib",   "label": "drawlib 资产" },
    { "id": "exc",   "label": ".excalidraw 产物" },
    { "id": "exp",   "label": "导出" },
    { "id": "art",   "label": "PNG/SVG" },
    { "id": "lint",  "label": "arch-lint" },
    { "id": "floor", "label": "floor-check" },
    { "id": "fix",   "label": "fix" },
    { "id": "rc",    "label": "round-check" }
