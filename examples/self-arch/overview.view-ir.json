    ["dir", "exc"],
    ["in", "clar", "enc", "arch", "prot", "form", "lib", "exp", "art"],
    ["lint", "floor", "fix", "rc"]
  ],
  "groups": [
    { "name": "上游(信息)", "members": ["in", "clar", "dir", "enc"] },
