  {
   "type": "text",
   "id": "wf-detail",
   "x": 40,
   "y": 500,
   "width": 540,
   "height": 68,
   "text": "1. Understand → 2. Explore + reuse assets → 3. Layout 4 questions\n→ 4. Junior pass (skeleton) → 5. Full pass (drawlib + connect)\n→ 6. (Optional) Animation → 7. Verify (arch-lint + human review)\n→ 8. Summarize.  Checkpoints: verify / asset-self-check / layout / delivery.",
   "fontSize": 10,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
